# ไบต์โค้ดของ Python
__pycache__/
*.py[cod]
*$py.class

# สภาพแวดล้อมเสมือน
.venv/
venv/
env/

# ตัวแปรสภาพแวดล้อม / ความลับ
.env
.env.*
secrets*.txt
*.secret

# ไฟล์ที่ระบบปฏิบัติการสร้าง
.DS_Store
Thumbs.db
desktop.ini

# เอาต์พุตชั่วคราว
*.log
build/
dist/
*.spec

# เครื่องมือ build ที่ดาวน์โหลดมา / ไฟล์ที่ generate
tools/wix/
tools/files.wxs

# ตัวติดตั้งที่ build ออกมา (แนบกับ GitHub Release แทนการ commit)
installer/*.msi
installer/*.exe
installer/*.rtf
installer/*.wixpdb
